  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "weui-uniapp-design": ["../packages/components/src/index"],
      "weui-uniapp-design/*": ["../packages/components/src/*"]
    }
  },
  "include": [

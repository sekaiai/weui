{
  "name": "weui-design-vue",
  "version": "0.2.0",
  "description": "支持 uni-app 的 WeUI Vue 3 组件库",
  "keywords": [
    "weui",
    "vue",
    "vue3",
    "uni-app",
    "wechat-miniprogram",
    "ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sekaiai/weui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekaiai/weui.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/sekaiai/weui/issues"
  },
  "main": "dist/vue3/index.mjs",
  "module": "dist/vue3/index.mjs",
  "types": "dist/vue3/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue3/index.mjs",
      "types": "./dist/vue3/types/index.d.ts"
    },
    "./dist/vue3/style.css": "./dist/vue3/style.css",
    "./uni-app": {
      "default": "./dist/uni-app/index.ts"
    },
    "./dist/uni-app/*": "./dist/uni-app/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "pnpm build",
    "pack:local": "pnpm build && node scripts/prepare-local-pack.mjs && npm pack --ignore-scripts --pack-destination ../../local-packages",
    "build": "pnpm build:vue3 && pnpm build:uni-app",
    "build:vue3": "vite build --mode vue3 && pnpm build:types",
    "build:uni-app": "node scripts/copy-uniapp-sfc.mjs && pnpm build:uni-app-components",
    "build:uni-app-components": "node scripts/copy-uniapp-components.mjs",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "release:check": "pnpm build && npm pack --dry-run"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "weui": "^2.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^14.0.0",
    "tsx": "4.23.1",
    "vite": "^5.4.21",
    "vitest": "^1.6.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}

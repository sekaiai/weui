{
  "name": "weui-uniapp-design",
  "version": "0.3.1",
  "type": "module",
  "description": "支持 uni-app 的 WeUI Vue 3 组件库",
  "keywords": [
    "weui",
    "vue",
    "vue3",
    "uni-app",
    "wechat-miniprogram",
    "ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sekaiai/weui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekaiai/weui.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/sekaiai/weui/issues"
  },
  "main": "dist/vue3/index.mjs",
  "module": "dist/vue3/index.mjs",
  "types": "dist/vue3/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vue3/types/index.d.ts",
      "import": "./dist/vue3/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue3/types/index.d.ts",
      "import": "./dist/vue3/index.mjs"
    },
    "./ssr": {
      "types": "./dist/vue3/types/index.d.ts",
      "import": "./dist/vue3/ssr.mjs"
    },
    "./index.css": "./dist/vue3/index.css",
    "./uni-app": "./dist/uni-app/index.ts",
    "./uni-app/*.vue": "./dist/uni-app/*.vue",
    "./dist/uni-app/*": "./dist/uni-app/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "sync:readme": "node scripts/sync-readme.mjs",
    "prepack": "pnpm sync:readme && pnpm build && pnpm check:package",
    "build": "pnpm build:vue3 && pnpm build:types && pnpm build:uni-app && pnpm check:uni-app",
    "build:vue3": "vite build && node scripts/create-ssr-entry.mjs",
    "build:uni-app": "node scripts/copy-uniapp-components.mjs",
    "check:uni-app": "node scripts/check-uni-app-compat.mjs",
    "check:package": "node scripts/check-package-contract.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "build:types": "vue-tsc -p tsconfig.build.json && node scripts/fix-declaration-imports.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "release:check": "pnpm test && pnpm typecheck && pnpm prepack && npm pack --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "weui": "^2.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^14.0.0",
    "tsx": "4.23.1",
    "vite": "^5.4.21",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^1.6.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}

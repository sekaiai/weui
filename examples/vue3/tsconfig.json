{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "weui-uniapp-design": ["../../packages/components/src/index"],
      "weui-uniapp-design/*": ["../../packages/components/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "../../packages/components/types/uni.d.ts",
    "../../packages/components/types/vue-global-properties.d.ts",
    "../../packages/components/src/globals.d.ts"
  ]
}

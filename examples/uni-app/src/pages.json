{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^weui-(.*)": "weui-design-vue/src/$1/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "WeUI Design Vue"
      }
    },
    {
      "path": "pages/actionsheet/actionsheet",
      "style": {
        "navigationBarTitleText": "Actionsheet 操作菜单"
      }
    },
    {
      "path": "pages/badge/badge",
      "style": {
        "navigationBarTitleText": "Badge 徽章"
      }
    },
    {
      "path": "pages/cell/cell",
      "style": {
        "navigationBarTitleText": "Cell 列表项"
      }
    },
    {
      "path": "pages/checkbox/checkbox",
      "style": {
        "navigationBarTitleText": "Checkbox 复选框"
      }
    },
    {
      "path": "pages/dialog/dialog",
      "style": {
        "navigationBarTitleText": "Dialog 对话框"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "WeUI Design Vue",
    "navigationBarBackgroundColor": "#f7f7f7",
    "backgroundColor": "#f7f7f7"
  }
}

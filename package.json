{
  "name": "weui-uniapp-design-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "基于 uni-app 的 WeUI 组件库 monorepo",
  "scripts": {
    "build": "pnpm --filter weui-uniapp-design build",
    "build:vue3": "pnpm --filter weui-uniapp-design build:vue3",
    "build:uni-app": "pnpm --filter weui-uniapp-design build:uni-app",
    "check:uni-app": "pnpm --filter weui-uniapp-design check:uni-app",
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "dev:example:mp": "pnpm --filter weui-uniapp-design-example dev:mp-weixin",
    "dev:example:h5": "pnpm --filter weui-uniapp-design-example dev:h5",
    "test": "pnpm --filter weui-uniapp-design test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.23"
    }
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
